#!/usr/bin/env python3

import os
import time
import subprocess
import RPi.GPIO as GPIO
from datetime import datetime

# =========================
# GPIO PINS
# =========================
relay_lv_out = 19
lv_press_pin = 13
relay_cue_light = 12
relay_mgz = 22
mgz_beam_pin = 21

# =========================
# GPIO SETUP
# =========================
GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)

try:
    # Setup pins
    GPIO.setup(relay_lv_out, GPIO.OUT)
    GPIO.setup(relay_mgz, GPIO.OUT)
    GPIO.setup(relay_cue_light, GPIO.OUT)
    GPIO.setup(lv_press_pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)
    GPIO.setup(mgz_beam_pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)

    # Initial relay state (True = OFF/Retracted)
    GPIO.output(relay_lv_out, True)
    GPIO.output(relay_mgz, True)
    GPIO.output(relay_cue_light, True)

    print(f"{datetime.now().isoformat()} ========== HARDWARE TESTING PHASE ==========")

    # 1 & 2) Lever extension and press test
    try:
        lv_dur = float(input("Enter duration to extend the lever (seconds): "))
    except ValueError:
        lv_dur = 5.0
        print(f"{datetime.now().isoformat()} Invalid input, defaulting to 5.0 seconds.")
        
    print(f"{datetime.now().isoformat()} Extending lever for {lv_dur} seconds. Please press the lever...")
    GPIO.output(relay_lv_out, False)
    
    start_time = time.time()
    last_state = GPIO.input(lv_press_pin)
    press_count = 0
    
    while time.time() - start_time < lv_dur:
        current_state = GPIO.input(lv_press_pin)
        # Detect HIGH to LOW transition
        if last_state == GPIO.HIGH and current_state == GPIO.LOW:
            press_count += 1
            print(f"{datetime.now().isoformat()} Lever press detected. Total: {press_count}")
        last_state = current_state
        time.sleep(0.05)
        
    GPIO.output(relay_lv_out, True)
    print(f"{datetime.now().isoformat()} Lever retracted.")

    # 3) Cue light test
    try:
        cue_dur = float(input("\nEnter duration to turn on the cue light (seconds): "))
    except ValueError:
        cue_dur = 5.0
        print(f"{datetime.now().isoformat()} Invalid input, defaulting to 5.0 seconds.")
        
    print(f"{datetime.now().isoformat()} Turning on cue light for {cue_dur} seconds...")
    GPIO.output(relay_cue_light, False)
    time.sleep(cue_dur)
    GPIO.output(relay_cue_light, True)
    print(f"{datetime.now().isoformat()} Cue light turned off.")

    # 4) Magazine relay test
    print(f"\n{datetime.now().isoformat()} Starting magazine relay test. You will need to press Enter 3 times.")
    for i in range(3):
        input(f"Test {i + 1}/3: Press Enter to turn on relay_mgz for 0.01s...")
        GPIO.output(relay_mgz, False)
        time.sleep(0.01)
        GPIO.output(relay_mgz, True)
        print(f"{datetime.now().isoformat()} Relay activated.")

    # 5) Beam break test
    try:
        beam_dur = float(input("\nEnter duration to test the beam break (seconds): "))
    except ValueError:
        beam_dur = 5.0
        print(f"{datetime.now().isoformat()} Invalid input, defaulting to 5.0 seconds.")
        
    print(f"{datetime.now().isoformat()} Testing beam break for {beam_dur} seconds. Please trigger the beam...")
    
    beam_break_count = 0
    def beam_callback(channel):
        global beam_break_count
        beam_break_count += 1
        print(f"{datetime.now().isoformat()} Beam break detected. Total: {beam_break_count}")

    GPIO.add_event_detect(mgz_beam_pin, GPIO.FALLING, callback=beam_callback, bouncetime=200)
    
    time.sleep(beam_dur)
    
    GPIO.remove_event_detect(mgz_beam_pin)
    print(f"{datetime.now().isoformat()} Beam break test completed.")

    # 6) Camera tests
    try:
        cam_dur = float(input("\nEnter duration to show each camera preview (seconds): "))
    except ValueError:
        cam_dur = 5.0
        print(f"{datetime.now().isoformat()} Invalid input, defaulting to 5.0 seconds.")

    print(f"\n{datetime.now().isoformat()} Testing USB camera...")
    usb_device_symlink = "/dev/v4l/by-id/usb-046d_HD_Pro_Webcam_C920_99F8F02F-video-index0"
    
    if os.path.exists(usb_device_symlink):
        real_usb_device = os.path.realpath(usb_device_symlink)
        try:
            # Using ffplay (native to Pi) instead of OpenCV
            proc_usb = subprocess.Popen([
                "ffplay", 
                "-f", "v4l2", 
                "-framerate", "15", 
                "-video_size", "640x480", 
                "-t", str(cam_dur), 
                "-autoexit", 
                "-window_title", "USB Camera Preview", 
                real_usb_device
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            proc_usb.wait()
            print(f"{datetime.now().isoformat()} USB camera test completed.")
        except FileNotFoundError:
            print(f"{datetime.now().isoformat()} Error: 'ffplay' not found. Please install ffmpeg.")
    else:
        print(f"{datetime.now().isoformat()} USB camera path does not exist: {usb_device_symlink}")

    # Wait for user input before opening the dual CSI cameras
    input(f"\nPress Enter to test BOTH CSI cameras side-by-side...")
    print(f"{datetime.now().isoformat()} Testing CSI cameras 0 and 1 for {cam_dur} seconds...")
    try:
        tmp_output0 = f"/tmp/test_csi_cam0.mp4"
        tmp_output1 = f"/tmp/test_csi_cam1.mp4"
        
        # Launch Camera 0 (Positioned on the left: X=50, Y=100)
        proc0 = subprocess.Popen([
            "rpicam-vid",
            "-t", str(int(cam_dur * 1000)),
            "--preview", "50,100,640,480", 
            "--inline",
            "--width", "640",
            "--height", "480",
            "--framerate", "15",
            "--camera", "0",
            "-o", tmp_output0
        ])
        
        # Launch Camera 1 (Positioned on the right: X=700, Y=100)
        proc1 = subprocess.Popen([
            "rpicam-vid",
            "-t", str(int(cam_dur * 1000)),
            "--preview", "700,100,640,480", 
            "--inline",
            "--width", "640",
            "--height", "480",
            "--framerate", "15",
            "--camera", "1",
            "-o", tmp_output1
        ])
        
        # Wait for both windows to automatically close after the duration
        proc0.wait()
        proc1.wait()
        
        # Clean up temporary files
        for tmp_file in [tmp_output0, tmp_output1]:
            if os.path.exists(tmp_file):
                os.remove(tmp_file)
            
        print(f"{datetime.now().isoformat()} Dual CSI camera test completed.")
    except Exception as e:
        print(f"{datetime.now().isoformat()} Failed to test CSI cameras: {e}")

    print(f"\n{datetime.now().isoformat()} ========== TESTING PHASE COMPLETE ==========")

except KeyboardInterrupt:
    print(f"\n{datetime.now().isoformat()} Testing phase interrupted by user.")

finally:
    GPIO.cleanup()
