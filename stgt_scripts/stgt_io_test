#!/usr/bin/env python3

import os
import time
import subprocess
import RPi.GPIO as GPIO
import readline
import glob
from datetime import datetime

# =========================
# GPIO PINS
# =========================
relay_lv_out = 19
lv_press_pin = 13
relay_cue_light = 12
relay_dsp = 22
fc_beam_pin = 21

# =========================
# HELPER FUNCTIONS
# =========================
def get_duration(prompt, default_val=5.0):
    """
    Pre-fills the input prompt with a default value.
    The user can press Enter to accept or use Backspace to change it.
    """
    readline.set_startup_hook(lambda: readline.insert_text(str(default_val)))
    try:
        user_input = input(prompt)
        val = float(user_input)
    except ValueError:
        val = float(default_val)
        print(f"{datetime.now().isoformat()} Invalid input, defaulting to {default_val} seconds.")
    finally:
        readline.set_startup_hook(None)  # Reset the hook for future inputs
    return val

def get_integer(prompt, default_val=3):
    """
    Pre-fills the input prompt with a default integer value.
    """
    readline.set_startup_hook(lambda: readline.insert_text(str(default_val)))
    try:
        user_input = input(prompt)
        val = int(user_input)
    except ValueError:
        val = int(default_val)
        print(f"{datetime.now().isoformat()} Invalid input, defaulting to {default_val}.")
    finally:
        readline.set_startup_hook(None)
    return val

# =========================
# TEST FUNCTIONS
# =========================
def test_lever():
    lv_dur = get_duration("\nEnter duration to extend the lever (seconds): ", 3.0)
        
    print(f"{datetime.now().isoformat()} Extending lever for {lv_dur} seconds. Please press the lever...")
    GPIO.output(relay_lv_out, False)
    
    start_time = time.time()
    last_state = GPIO.input(lv_press_pin)
    press_count = 0
    
    while time.time() - start_time < lv_dur:
        current_state = GPIO.input(lv_press_pin)
        if last_state == GPIO.HIGH and current_state == GPIO.LOW:
            press_count += 1
            print(f"{datetime.now().isoformat()} Lever press detected. Total: {press_count}")
        last_state = current_state
        time.sleep(0.05)
        
    GPIO.output(relay_lv_out, True)
    print(f"{datetime.now().isoformat()} Lever retracted.")


def test_cue_light():
    cue_dur = get_duration("\nEnter duration to turn on the cue light (seconds): ", 2.0)
        
    print(f"{datetime.now().isoformat()} Turning on cue light for {cue_dur} seconds...")
    GPIO.output(relay_cue_light, False)
    time.sleep(cue_dur)
    GPIO.output(relay_cue_light, True)
    print(f"{datetime.now().isoformat()} Cue light turned off.")


def test_dispenser():
    dispense_count = get_integer("\nEnter number of times to test the dispenser relay: ", 2)
    print(f"\n{datetime.now().isoformat()} Starting dispenser relay test. You will need to press Enter {dispense_count} times.")
    for i in range(dispense_count):
        input(f"Test {i + 1}/{dispense_count}: Press Enter to turn on relay_dsp for 0.01s...")
        GPIO.output(relay_dsp, False)
        time.sleep(0.01)
        GPIO.output(relay_dsp, True)
        print(f"{datetime.now().isoformat()} Relay activated.")


def test_fcbeam():
    beam_dur = get_duration("\nEnter duration to test the food cup beam break (seconds): ", 5.0)
        
    print(f"{datetime.now().isoformat()} Testing beam break for {beam_dur} seconds. Please reach into the food cup...")
    
    beam_break_count = 0
    def beam_callback(channel):
        nonlocal beam_break_count  # Correct syntax since this is now nested inside a function
        beam_break_count += 1
        print(f"{datetime.now().isoformat()} Beam break detected. Total: {beam_break_count}")

    GPIO.add_event_detect(fc_beam_pin, GPIO.FALLING, callback=beam_callback, bouncetime=200)
    time.sleep(beam_dur)
    GPIO.remove_event_detect(fc_beam_pin)
    print(f"{datetime.now().isoformat()} Beam break test completed.")


def test_usb_camera():
    cam_dur = get_duration("\nEnter duration to show USB camera preview (seconds): ", 5.0)

    print(f"\n{datetime.now().isoformat()} Testing USB camera...")
    
    # Dynamically search for any USB camera's primary video feed
    usb_cams = glob.glob("/dev/v4l/by-id/usb-*-video-index0")
    
    if not usb_cams:
        print(f"{datetime.now().isoformat()} Error: No USB camera found connected to the system.")
        return
        
    usb_device_symlink = usb_cams[0]
    print(f"{datetime.now().isoformat()} Found USB camera at: {usb_device_symlink}")
    
    real_usb_device = os.path.realpath(usb_device_symlink)
    
    try:
        proc_usb = subprocess.Popen([
            "ffplay", 
            "-f", "v4l2", 
            "-framerate", "15", 
            "-video_size", "640x480", 
            "-window_title", "USB Camera Preview", 
            real_usb_device
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        try:
            # Wait for the specific duration, then kill the process
            proc_usb.wait(timeout=cam_dur)
        except subprocess.TimeoutExpired:
            proc_usb.terminate()
            proc_usb.wait()
            
        print(f"{datetime.now().isoformat()} USB camera test completed.")
    except FileNotFoundError:
        print(f"{datetime.now().isoformat()} Error: 'ffplay' not found. Please install ffmpeg.")


def test_csi_cameras():
    cam_dur = get_duration("\nEnter duration to show CSI cameras preview (seconds): ", 5.0)

    print(f"\n{datetime.now().isoformat()} Testing CSI cameras 0 and 1 side-by-side for {cam_dur} seconds...")
    try:
        tmp_output0 = f"/tmp/test_csi_cam0.mp4"
        tmp_output1 = f"/tmp/test_csi_cam1.mp4"
        
        proc0 = subprocess.Popen([
            "rpicam-vid",
            "-t", str(int(cam_dur * 1000)),
            "--preview", "10,50,400,300", 
            "--inline", "--width", "640", "--height", "480", "--framerate", "15",
            "--camera", "0", "-o", tmp_output0
        ])
        
        proc1 = subprocess.Popen([
            "rpicam-vid",
            "-t", str(int(cam_dur * 1000)),
            "--preview", "420,50,400,300", 
            "--inline", "--width", "640", "--height", "480", "--framerate", "15",
            "--camera", "1", "-o", tmp_output1
        ])
        
        # Use a strict timeout with a 3-second buffer for hardware warmup
        timeout_limit = cam_dur + 3.0
        
        for proc, cam_name in [(proc0, "CSI 0"), (proc1, "CSI 1")]:
            try:
                proc.wait(timeout=timeout_limit)
            except subprocess.TimeoutExpired:
                print(f"{datetime.now().isoformat()} WARNING: {cam_name} hung (likely hardware/connection failure). Force terminating...")
                proc.kill()  # Use kill() instead of terminate() to force close frozen drivers
                proc.wait()
        
        for tmp_file in [tmp_output0, tmp_output1]:
            if os.path.exists(tmp_file):
                os.remove(tmp_file)
            
        print(f"{datetime.now().isoformat()} Dual CSI camera test completed.")
    except Exception as e:
        print(f"{datetime.now().isoformat()} Failed to test CSI cameras: {e}")


def test_all():
    test_lever()
    test_cue_light()
    test_dispenser()
    test_fcbeam()
    test_usb_camera()
    input("\nPress Enter to test BOTH CSI cameras side-by-side...")
    test_csi_cameras()


# =========================
# MAIN INITIALIZATION
# =========================
if __name__ == "__main__":
    GPIO.setmode(GPIO.BCM)
    GPIO.setwarnings(False)

    try:
        # Setup pins
        GPIO.setup(relay_lv_out, GPIO.OUT)
        GPIO.setup(relay_dsp, GPIO.OUT)
        GPIO.setup(relay_cue_light, GPIO.OUT)
        GPIO.setup(lv_press_pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)
        GPIO.setup(fc_beam_pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)

        # Initial relay state (True = OFF/Retracted)
        GPIO.output(relay_lv_out, True)
        GPIO.output(relay_dsp, True)
        GPIO.output(relay_cue_light, True)

        print(f"\n{datetime.now().isoformat()} ========== HARDWARE TESTING PHASE ==========")

        while True:
            print("\n--- STGT Hardware Test Menu ---")
            print("1. Test Lever Extension & Press")
            print("2. Test Cue Light")
            print("3. Test Dispenser Relay")
            print("4. Test Food Cup Beam Break")
            print("5. Test USB Camera")
            print("6. Test CSI Cameras (Side-by-side)")
            print("7. Test ALL Components Sequentially")
            print("8. Exit Testing Phase")
            
            choice = input("\nEnter your choice (1-8): ").strip()
            
            if choice == '1':
                test_lever()
            elif choice == '2':
                test_cue_light()
            elif choice == '3':
                test_dispenser()
            elif choice == '4':
                test_fcbeam()
            elif choice == '5':
                test_usb_camera()
            elif choice == '6':
                test_csi_cameras()
            elif choice == '7':
                test_all()
            elif choice == '8':
                print(f"\n{datetime.now().isoformat()} Exiting test menu.")
                break
            else:
                print("Invalid choice. Please enter a number from 1 to 8.")

        print(f"\n{datetime.now().isoformat()} ========== TESTING PHASE COMPLETE ==========")

    except KeyboardInterrupt:
        print(f"\n{datetime.now().isoformat()} Testing phase interrupted by user.")

    finally:
        GPIO.cleanup()
